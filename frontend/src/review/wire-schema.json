{
  "$defs": {
    "AgentId": {
      "enum": [
        "planner",
        "bug_reliability",
        "logic_correctness",
        "quality_testability",
        "architecture_security",
        "performance_scalability",
        "synthesizer_verifier"
      ],
      "title": "AgentId",
      "type": "string"
    },
    "BalancedLimits": {
      "additionalProperties": false,
      "properties": {
        "command_timeout_seconds": {
          "default": 120,
          "maximum": 120,
          "minimum": 1,
          "title": "Command Timeout Seconds",
          "type": "integer"
        },
        "concurrent_model_calls": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Concurrent Model Calls",
          "type": "integer"
        },
        "final_agent_tokens": {
          "default": 50000,
          "maximum": 50000,
          "minimum": 1,
          "title": "Final Agent Tokens",
          "type": "integer"
        },
        "iterations_per_task": {
          "default": 8,
          "maximum": 8,
          "minimum": 1,
          "title": "Iterations Per Task",
          "type": "integer"
        },
        "job_tokens": {
          "default": 250000,
          "maximum": 250000,
          "minimum": 1,
          "title": "Job Tokens",
          "type": "integer"
        },
        "model_context_tokens": {
          "default": 32768,
          "maximum": 131072,
          "minimum": 4096,
          "title": "Model Context Tokens",
          "type": "integer"
        },
        "planner_output_tokens": {
          "default": 4096,
          "maximum": 8192,
          "minimum": 512,
          "title": "Planner Output Tokens",
          "type": "integer"
        },
        "planner_tokens": {
          "default": 25000,
          "maximum": 25000,
          "minimum": 1,
          "title": "Planner Tokens",
          "type": "integer"
        },
        "provider_timeout_seconds": {
          "default": 30,
          "maximum": 30,
          "minimum": 1,
          "title": "Provider Timeout Seconds",
          "type": "integer"
        },
        "review_rounds": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Review Rounds",
          "type": "integer"
        },
        "review_seconds": {
          "default": 600,
          "maximum": 600,
          "minimum": 1,
          "title": "Review Seconds",
          "type": "integer"
        },
        "schema_repairs_per_task": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Schema Repairs Per Task",
          "type": "integer"
        },
        "specialist_tokens": {
          "default": 50000,
          "maximum": 50000,
          "minimum": 1,
          "title": "Specialist Tokens",
          "type": "integer"
        },
        "tool_calls_per_task": {
          "default": 12,
          "maximum": 12,
          "minimum": 1,
          "title": "Tool Calls Per Task",
          "type": "integer"
        },
        "transient_retries": {
          "default": 2,
          "maximum": 2,
          "minimum": 0,
          "title": "Transient Retries",
          "type": "integer"
        }
      },
      "required": [
        "command_timeout_seconds",
        "concurrent_model_calls",
        "final_agent_tokens",
        "iterations_per_task",
        "job_tokens",
        "model_context_tokens",
        "planner_tokens",
        "provider_timeout_seconds",
        "review_rounds",
        "review_seconds",
        "schema_repairs_per_task",
        "specialist_tokens",
        "tool_calls_per_task",
        "transient_retries"
      ],
      "title": "BalancedLimits",
      "type": "object"
    },
    "BudgetLedger": {
      "additionalProperties": false,
      "properties": {
        "agent_usage": {
          "additionalProperties": {
            "$ref": "#/$defs/TokenUsage"
          },
          "propertyNames": {
            "$ref": "#/$defs/AgentId"
          },
          "title": "Agent Usage",
          "type": "object"
        },
        "elapsed_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "inflight": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelReservation"
          },
          "title": "Inflight",
          "type": "object"
        },
        "operation_retries": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Operation Retries",
          "type": "object"
        },
        "review_round": {
          "default": 1,
          "maximum": 2,
          "minimum": 1,
          "title": "Review Round",
          "type": "integer"
        },
        "task_iterations": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Task Iterations",
          "type": "object"
        },
        "task_schema_repairs": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Task Schema Repairs",
          "type": "object"
        },
        "task_tools": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Task Tools",
          "type": "object"
        }
      },
      "required": [
        "agent_usage",
        "elapsed_seconds",
        "inflight",
        "operation_retries",
        "review_round",
        "task_iterations",
        "task_schema_repairs",
        "task_tools"
      ],
      "title": "BudgetLedger",
      "type": "object"
    },
    "CaptureCoverage": {
      "additionalProperties": false,
      "description": "Client-reported omissions; this contract cannot assert source inspection.",
      "properties": {
        "failed": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 1000,
          "title": "Failed",
          "type": "object"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Limitations",
          "type": "array"
        },
        "skipped": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 1000,
          "title": "Skipped",
          "type": "object"
        }
      },
      "required": [
        "failed",
        "limitations",
        "skipped"
      ],
      "title": "CaptureCoverage",
      "type": "object"
    },
    "CausalReview": {
      "additionalProperties": false,
      "properties": {
        "assessments": {
          "items": {
            "$ref": "#/$defs/ClaimAssessment"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Assessments",
          "type": "array"
        },
        "candidate_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Digest",
          "type": "string"
        },
        "causal_basis": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Causal Basis",
          "type": "string"
        }
      },
      "required": [
        "assessments",
        "candidate_digest",
        "causal_basis"
      ],
      "title": "CausalReview",
      "type": "object"
    },
    "ClaimAssessment": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "explanation": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "field": {
          "enum": [
            "title",
            "description",
            "impact",
            "remediation"
          ],
          "title": "Field",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "uncertain"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evidence_refs",
        "explanation",
        "field",
        "status"
      ],
      "title": "ClaimAssessment",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Failed",
          "type": "object"
        },
        "inspected_files": {
          "items": {
            "type": "string"
          },
          "title": "Inspected Files",
          "type": "array"
        },
        "inspected_symbols": {
          "items": {
            "type": "string"
          },
          "title": "Inspected Symbols",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "skipped": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Skipped",
          "type": "object"
        }
      },
      "required": [
        "failed",
        "inspected_files",
        "inspected_symbols",
        "limitations",
        "skipped"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Disagreement": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Finding Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "resolution": {
          "enum": [
            "resolved",
            "unresolved"
          ],
          "title": "Resolution",
          "type": "string"
        }
      },
      "required": [
        "evidence_refs",
        "finding_ids",
        "rationale",
        "resolution"
      ],
      "title": "Disagreement",
      "type": "object"
    },
    "DuplicateReview": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Finding Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "evidence_refs",
        "finding_ids",
        "rationale"
      ],
      "title": "DuplicateReview",
      "type": "object"
    },
    "EventPayload": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attempt": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "end_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "execution_failed",
                "review_time_exhausted",
                "provider_authentication",
                "provider_quota",
                "provider_rate_limit",
                "provider_temporary",
                "provider_timeout",
                "provider_failure",
                "invalid_schema",
                "recoverable_tool_error",
                "permission_denied",
                "unknown_tool_completion",
                "specialist_failed",
                "tool_timeout",
                "tool_execution_failed",
                "repeated_tool_failure",
                "evidence_integrity_failure",
                "snapshot_integrity_failure",
                "invalid_source_range",
                "invalid_evidence_offset",
                "evidence_not_found",
                "invalid_arguments",
                "tool_unavailable",
                "parser_unavailable",
                "invalid_configuration",
                "invalid_query",
                "database_unavailable",
                "tool_read_failure"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        },
        "finding_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        },
        "finish_reason": {
          "anyOf": [
            {
              "enum": [
                "stop",
                "length",
                "content_filter",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        },
        "graph_scope": {
          "anyOf": [
            {
              "enum": [
                "review",
                "agent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Scope"
        },
        "iteration": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iteration"
        },
        "node": {
          "anyOf": [
            {
              "enum": [
                "repository_intelligence",
                "deterministic_analysis",
                "change_analyzer",
                "planner_agent",
                "context_manager",
                "budget_manager",
                "deterministic_router",
                "specialist_subgraphs",
                "shared_blackboard",
                "structural_evidence_gate",
                "completion_workflow",
                "investigate",
                "execute_action"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "operation_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "succeeded",
                "failed",
                "cancelled",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "phase": {
          "anyOf": [
            {
              "enum": [
                "planning",
                "investigation",
                "verification",
                "synthesis",
                "structural_gate",
                "acceptance",
                "rendering",
                "finalization"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "queued",
                "running",
                "interrupted",
                "completed",
                "failed",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "stop_reason": {
          "anyOf": [
            {
              "enum": [
                "evidence_complete",
                "finished_without_result",
                "invalid_schema",
                "model_unavailable",
                "evidence_incomplete",
                "no_progress",
                "tools_unavailable",
                "unknown_tool_completion",
                "permission_denied",
                "budget_exhausted",
                "prompt_context_limit",
                "context_timeout",
                "tool_timeout",
                "provider_truncated",
                "provider_incomplete",
                "cancelled",
                "specialist_failed",
                "execution_failed",
                "review_time_exhausted",
                "final_consistency_failure",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[\\w.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "tool": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z][a-z_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "confirmed",
                "uncertain",
                "rejected",
                "advisory"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        }
      },
      "required": [
        "agent_id",
        "duration_seconds",
        "error_code",
        "evidence_ref",
        "status",
        "task_id",
        "tool",
        "total_tokens"
      ],
      "title": "EventPayload",
      "type": "object"
    },
    "FollowupRequest": {
      "additionalProperties": false,
      "properties": {
        "evidence_needed": {
          "minLength": 1,
          "title": "Evidence Needed",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_needed",
        "question",
        "task_id"
      ],
      "title": "FollowupRequest",
      "type": "object"
    },
    "GitMetadata": {
      "additionalProperties": false,
      "properties": {
        "diffs": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "maxProperties": 100,
          "title": "Diffs",
          "type": "object"
        },
        "history": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxProperties": 100,
          "title": "History",
          "type": "object"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "diffs",
        "history",
        "limitations"
      ],
      "title": "GitMetadata",
      "type": "object"
    },
    "JobView": {
      "additionalProperties": false,
      "description": "Owned transport view: no principal, raw source, private state or API keys.",
      "properties": {
        "created_at": {
          "minimum": 0,
          "title": "Created At",
          "type": "number"
        },
        "job_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "ledger": {
          "$ref": "#/$defs/BudgetLedger"
        },
        "limits": {
          "$ref": "#/$defs/BalancedLimits"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "interrupted",
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "updated_at": {
          "minimum": 0,
          "title": "Updated At",
          "type": "number"
        },
        "workflow_version": {
          "const": "seven-agent-v1",
          "title": "Workflow Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "job_id",
        "ledger",
        "limits",
        "snapshot_id",
        "status",
        "updated_at",
        "workflow_version"
      ],
      "title": "JobView",
      "type": "object"
    },
    "ModelReservation": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "tokens": {
          "minimum": 1,
          "title": "Tokens",
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "tokens"
      ],
      "title": "ModelReservation",
      "type": "object"
    },
    "PersistedEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "job_queued",
            "job_running",
            "job_interrupted",
            "job_completed",
            "job_failed",
            "job_cancelled",
            "agent_started",
            "agent_status_changed",
            "reasoning_step",
            "tool_called",
            "tool_result",
            "file_opened",
            "search_performed",
            "finding_created",
            "validation_passed",
            "validation_failed",
            "retry_started",
            "error_occurred",
            "agent_completed",
            "budget_updated",
            "iteration_started",
            "model_call_started",
            "model_call_completed",
            "agent_reused",
            "evidence_retrieved",
            "evidence_delivered",
            "evidence_inspected",
            "candidate_submitted",
            "candidate_rejected",
            "verification_completed",
            "finalization_started",
