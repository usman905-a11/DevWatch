# DevWatch Environment Variables Template
# Groq Model Setup

# Target Groq Models
LLM_MODEL=llama-3.3-70b-versatile
DEVWATCH_FAST_MODEL=llama-3.1-8b-instant
DEVWATCH_HEAVY_MODEL=llama-3.3-70b-versatile

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# DevWatch Server Configuration (Optional)
DEVWATCH_ENV=development
DEVWATCH_API_KEY=your_server_api_key_here

# LangGraph local review execution
DEVWATCH_RUN_COMMANDS=true
DEVWATCH_COMMAND_TIMEOUT=120
DEVWATCH_COMMAND_MAX_OUTPUT=200000
DEVWATCH_VERIFICATION_THRESHOLD=0.8
DEVWATCH_CHECKPOINT_DB=.devwatch/checkpoints.sqlite
DEVWATCH_RUNS_DIR=.devwatch/runs
DEVWATCH_ARTIFACT_RETENTION_DAYS=7
