# DevWatch Environment Variables Template
# Copy this file to .env and fill in your API secrets

# Target LLM Model (Defaults to openrouter/free when OPENROUTER_API_KEY is configured)
LLM_MODEL=openrouter/free

# OpenAI API Key (For GPT-4o / GPT-4o-mini agent reasoning)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (Optional: Access models from Anthropic, OpenAI, Meta, Google via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini API Key (Optional: For Gemini Flash/Pro agent reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key (Optional: For Claude Sonnet agent reasoning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Serper API Key (Optional: For web search capabilities)
SERPER_API_KEY=your_serper_api_key_here


