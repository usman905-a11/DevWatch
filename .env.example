# Copy needed entries into your local environment. Do not put real keys in this file.
DEVWATCH_ENV=development
DEVWATCH_API_KEY=replace-with-a-private-server-key
DEVWATCH_WORKSPACE_DIR=.
GROQ_API_KEY=replace-with-your-provider-key
LLM_MODEL=llama-3.3-70b-versatile
DEVWATCH_FAST_MODEL=llama-3.1-8b-instant
DEVWATCH_HEAVY_MODEL=llama-3.3-70b-versatile

# Disable execution of reviewed-project commands unless you trust the code.
DEVWATCH_RUN_COMMANDS=false
DEVWATCH_COMMAND_TIMEOUT=120
DEVWATCH_COMMAND_MAX_OUTPUT=200000
DEVWATCH_REVIEW_TIMEOUT=120
DEVWATCH_MAX_CONCURRENT_LLM=10
DEVWATCH_MAX_JOB_TOKENS=250000
DEVWATCH_MAX_FILES_PER_REVIEW=100
DEVWATCH_MAX_FILE_COUNT=1000
DEVWATCH_MAX_REPO_TOTAL_BYTES=10000000
DEVWATCH_MAX_REPO_SIZE_BYTES=104857600
DEVWATCH_MAX_CANDIDATE_FINDINGS=1000
DEVWATCH_VERIFICATION_THRESHOLD=0.8

# Source artifacts are pruned on engine startup. Checkpoints/reports need operator cleanup.
DEVWATCH_RUNS_DIR=.devwatch/runs
DEVWATCH_ARTIFACT_RETENTION_DAYS=7
DEVWATCH_CHECKPOINT_DB=.devwatch/checkpoints.sqlite
