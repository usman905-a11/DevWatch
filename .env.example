# Export required variables in the service process. Library imports do not load .env.
# Placeholders only; never put real credentials in source control.
DEVWATCH_MODEL_SMALL=replace-with-supported-small-model-id
DEVWATCH_MODEL_MEDIUM=replace-with-supported-medium-model-id
DEVWATCH_MODEL_STRONG=replace-with-supported-strong-model-id
DEVWATCH_PROVIDER=openai
DEVWATCH_RUNTIME_DIR=.devwatch/runtime
DEVWATCH_SERVICE_URL=http://127.0.0.1:8000
DEVWATCH_ENV=development
DEVWATCH_API_KEY=replace-with-private-local-service-key
OPENAI_API_KEY=replace-with-provider-key
# Gemini: DEVWATCH_PROVIDER=gemini and GEMINI_API_KEY.
# OpenRouter: OPENROUTER_API_KEY with the compatible provider adapter.
# Balanced budgets live in review/contracts.py.
# Optional operator-owned exact command/database policies; disabled when omitted:
# DEVWATCH_TRUSTED_TOOLS_FILE=C:/private/devwatch-commands.json
# DEVWATCH_DATABASE_POLICIES_FILE=C:/private/devwatch-databases.json
DEVWATCH_LANGSMITH_METADATA=false
DEVWATCH_LANGSMITH_PROJECT=devwatch-metadata
# LANGSMITH_API_KEY=replace-only-for-explicit-metadata-export
