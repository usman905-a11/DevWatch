{
  "version": "review-eval-v1",
  "description": "Offline changed-file fixtures for confirmed-finding precision and recall.",
  "cases": [
    {
      "id": "secret_app_key",
      "file_path": "config.py",
      "before": "API_KEY = get_secret('API_KEY')\n",
      "after": "API_KEY = 'sk_live_1234567890abcdef'\n",
      "expected_titles": ["Hardcoded Secret Credential"]
    },
    {
      "id": "secret_database_password",
      "file_path": "database.py",
      "before": "PASSWORD = os.environ['DB_PASSWORD']\n",
      "after": "PASSWORD = 'prodpassword123'\n",
      "expected_titles": ["Hardcoded Secret Credential"]
    },
    {
      "id": "secret_auth_token",
      "file_path": "auth.py",
      "before": "AUTH_TOKEN = token_from_env()\n",
      "after": "AUTH_TOKEN = 'realtoken1234567'\n",
      "expected_titles": ["Hardcoded Secret Credential"]
    },
    {
      "id": "eval_user_formula",
      "file_path": "formula.py",
      "before": "result = parse_formula(user_formula)\n",
      "after": "result = eval(user_formula)\n",
      "expected_titles": ["Dynamic Code Execution via eval()"]
    },
    {
      "id": "eval_payload",
      "file_path": "payload.py",
      "before": "value = json.loads(payload)\n",
      "after": "value = eval(payload)\n",
      "expected_titles": ["Dynamic Code Execution via eval()"]
    },
    {
      "id": "exec_script",
      "file_path": "script.py",
      "before": "run_validated_script(script)\n",
      "after": "exec(script)\n",
      "expected_titles": ["Dynamic Code Execution via exec()"]
    },
    {
      "id": "bare_except_worker",
      "file_path": "worker.py",
      "before": "try:\n    run_job()\nexcept JobError:\n    log_error()\n",
      "after": "try:\n    run_job()\nexcept:\n    pass\n",
      "expected_titles": ["Bare Except Swallowing Exception"]
    },
    {
      "id": "bare_except_api",
      "file_path": "api.py",
      "before": "try:\n    send()\nexcept NetworkError:\n    raise\n",
      "after": "try:\n    send()\nexcept Exception:\n    pass\n",
      "expected_titles": ["Bare Except Swallowing Exception"]
    },
    {
      "id": "sql_interpolation",
      "file_path": "queries.py",
      "before": "query = 'SELECT * FROM users WHERE id = %s'\n",
      "after": "query = f'SELECT * FROM users WHERE id = {user_id}'\n",
      "expected_titles": ["Potential SQL Injection Vulnerability"]
    },
    {
      "id": "os_system_input",
      "file_path": "network.py",
      "before": "subprocess.run(['ping', host], check=True)\n",
      "after": "os.system('ping ' + host)\n",
      "expected_titles": ["OS Command Injection via os.system"]
    },
    {
      "id": "clean_parameterized_query",
      "file_path": "safe_query.py",
      "before": "query = 'SELECT * FROM users'\n",
      "after": "cursor.execute('SELECT * FROM users WHERE id = %s', (user_id,))\n",
      "expected_titles": []
    },
    {
      "id": "clean_json_parse",
      "file_path": "parse.py",
      "before": "value = payload\n",
      "after": "value = json.loads(payload)\n",
      "expected_titles": []
    },
    {
      "id": "clean_specific_except",
      "file_path": "errors.py",
      "before": "process(data)\n",
      "after": "try:\n    process(data)\nexcept ValueError:\n    logger.warning('invalid input')\n",
      "expected_titles": []
    },
    {
      "id": "clean_env_secret",
      "file_path": "safe_auth.py",
      "before": "TOKEN = None\n",
      "after": "TOKEN = os.environ['AUTH_TOKEN']\n",
      "expected_titles": []
    },
    {
      "id": "clean_argv_process",
      "file_path": "process.py",
      "before": "result = None\n",
      "after": "result = subprocess.run(['git', 'status'], check=True, capture_output=True)\n",
      "expected_titles": []
    },
    {
      "id": "clean_math",
      "file_path": "math_utils.py",
      "before": "def add(a, b):\n    return 0\n",
      "after": "def add(a, b):\n    return a + b\n",
      "expected_titles": []
    },
    {
      "id": "clean_async_wait",
      "file_path": "async_worker.py",
      "before": "async def wait():\n    pass\n",
      "after": "async def wait():\n    await asyncio.sleep(1)\n",
      "expected_titles": []
    },
    {
      "id": "clean_safe_lookup",
      "file_path": "lookup.py",
      "before": "value = None\n",
      "after": "value = allowed_operations.get(operation)\n",
      "expected_titles": []
    },
    {
      "id": "clean_test_credential_literal",
      "file_path": "tests/test_auth.py",
      "before": "def test_login():\n    pass\n",
      "after": "def test_login():\n    SECRET_KEY = 'testonlyvalue123'\n    assert SECRET_KEY\n",
      "expected_titles": []
    },
    {
      "id": "clean_logging",
      "file_path": "logging_utils.py",
      "before": "print('done')\n",
      "after": "logger.info('done')\n",
      "expected_titles": []
    }
  ]
}
